# --- SEGURANÇA EM PRODUÇÃO (VERCEL) ---
# Na Vercel, NUNCA use o prefixo VITE_ para chaves de API confidenciais (elas vazam para o browser).
# Em vez disso, cadastre no dashboard da Vercel as variáveis seguras (sem o prefixo VITE_):
# OPENROUTER_API_KEY=sua_chave_aqui
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# --- DESENVOLVIMENTO LOCAL ---
# Opcional: preencha as variáveis abaixo para testar diretamente no browser no ambiente local
VITE_OPENROUTER_API_KEY=sua_chave_aqui
VITE_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
